# mock runs locally without network credentials; live validates Twilio and sends WhatsApp replies.
APP_MODE=mock
DATABASE_PATH=data/turnpilot.db
MEDIA_DIR=data/photos
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact public URL registered as the Sandbox incoming webhook, including /whatsapp.
TWILIO_WEBHOOK_URL=
# Optional internal observer page. Required to open /observer in live mode.
# Browser username is demo; choose a private password here.
OBSERVER_PASSWORD=
# AI_PROVIDER=gemini is the preferred live demo path; use openai as an alternative.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
